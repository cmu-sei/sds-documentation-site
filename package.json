  "version": "1.6.0",
  "main": "./nuxt.config.ts",
  "scripts": {
    "dev": "npx nuxi dev .playground",
    "dev:prepare": "npx nuxt prepare .playground",
    "build": "NODE_OPTIONS='--max-old-space-size=8192' npx nuxt build .playground",
    "generate": "NODE_OPTIONS='--max-old-space-size=8192' npx nuxt generate .playground",
    "preview": "npx nuxt preview .playground",
    "lint": "npx eslint .",
    "test": "node --test tests/*.test.mjs",
    "release": "./scripts/release.sh"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@vueuse/core": "^14.1.0",
    "eslint": "^10.9.1",
