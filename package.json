  "dependencies": {
    "@cmu-sei/sei-design-system": "^4.14.0",
    "@iconify-json/material-symbols": "^1.2.89",
    "@nuxt/content": "^3.15.2",
    "@nuxt/icon": "^2.5.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@vueuse/nuxt": "^14.4.0",
    "better-sqlite3": "^12.11.1",
    "nuxt-gtag": "^5.0.0",
    "nuxt-link-checker": "^5.3.0",
    "sitemap": "^9.0.1",
    "tailwindcss": "^4.0.12"
